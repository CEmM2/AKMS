{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failure lesson",
  "description": "One lesson of an akms-failure-memory registry, field for field. Written by akms-records import --from-failure-memory; the registry stays the authority.",
  "type": "object",
  "required": [
    "id",
    "date_found",
    "date_found_precision",
    "date_fixed",
    "date_fixed_precision",
    "location",
    "found_by",
    "symptom",
    "root_cause",
    "fix",
    "prevention",
    "references",
    "related"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "precision": {
      "enum": [
        "exact",
        "approximate"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "The lesson ID, sequential (L001) or dated (L20261028-k3f9)."
    },
    "date_found": {
      "$ref": "#/$defs/date"
    },
    "date_found_precision": {
      "$ref": "#/$defs/precision"
    },
    "date_fixed": {
      "$ref": "#/$defs/date"
    },
    "date_fixed_precision": {
      "$ref": "#/$defs/precision"
    },
    "location": {
      "type": "object",
      "required": [
        "area",
        "package",
        "module",
        "file",
        "symbol",
        "line_hint"
      ],
      "additionalProperties": false,
      "properties": {
        "area": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string"
        },
        "line_hint": {
          "type": "string"
        }
      }
    },
    "found_by": {
      "type": "object",
      "required": [
        "type",
        "trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        }
      }
    },
    "symptom": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "fix": {
      "type": "string"
    },
    "prevention": {
      "type": "string"
    },
    "references": {
      "type": "object",
      "required": [
        "commit",
        "issue",
        "pr",
        "plan"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "pr": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        }
      }
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "x-akms-records": {
    "name": "failure-lesson",
    "version": 1,
    "title": "Failure lesson",
    "description": "A lesson imported from an akms-failure-memory registry.",
    "rules": {
      "search_text": [
        "/symptom",
        "/root_cause",
        "/fix",
        "/prevention",
        "/location/file",
        "/location/symbol",
        "/notes"
      ],
      "label": "/id",
      "time_field": "/date_found"
    }
  }
}
