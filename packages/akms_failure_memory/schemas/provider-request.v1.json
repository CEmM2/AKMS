{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akms.local/schemas/failure-memory-provider-request.v1.json",
  "title": "Failure Memory Provider Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "repository_id", "baseline", "mode", "role", "declared_paths", "refresh_policy", "output_dir", "task"],
  "properties": {
    "schema_version": {"const": "failure-memory-provider-request/v1"},
    "invocation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "repository_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "baseline": {"type": "string", "minLength": 1},
    "mode": {"enum": ["pre-task", "post-diff"]},
    "role": {"enum": ["implementer", "code_reviewer", "physics_reviewer"]},
    "declared_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "base": {"type": ["string", "null"], "minLength": 1},
    "head": {"type": ["string", "null"], "minLength": 1},
    "refresh_policy": {"enum": ["never", "require-current"]},
    "output_dir": {"type": "string", "minLength": 1},
    "task": {"type": "object"}
  }
}
